{
  "info": {
    "name": "Plan Measuring Tool API",
    "description": "FastAPI backend for the Plan Measuring Tool. Run 'Login' after 'Signup' once — it auto-saves the returned token into the {{token}} collection variable, which every other request uses for its Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "email", "value": "test@example.com", "type": "string" },
    { "key": "password", "value": "TestPass123!", "type": "string" },
    { "key": "pdf_id", "value": "", "type": "string" },
    { "key": "page_number", "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/signup",
              "host": ["{{base_url}}"],
              "path": ["signup"]
            },
            "description": "Creates the user directly in Firebase Authentication. Returns {id, email}."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.token);",
                  "    console.log('Saved token to {{token}} collection variable');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Verifies the password against Firebase Auth and returns {id, email, token} - token is a real Firebase ID token, auto-saved to {{token}} by this request's test script."
          }
        }
      ]
    },
    {
      "name": "PDFs",
      "item": [
        {
          "name": "Upload PDF",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                {
                  "key": "pages",
                  "type": "text",
                  "value": "all",
                  "description": "\"all\" or a comma-separated list of page numbers, e.g. \"1,3,5\""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/upload",
              "host": ["{{base_url}}"],
              "path": ["upload"]
            },
            "description": "Stores the PDF, then kicks off the background processing job for the requested pages only. Returns {id, filename, page_count} - copy the id into the {{pdf_id}} variable to use the requests below."
          }
        },
        {
          "name": "List my PDFs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pdfs",
              "host": ["{{base_url}}"],
              "path": ["pdfs"]
            },
            "description": "Returns every PDF owned by the caller, most recently uploaded first."
          }
        },
        {
          "name": "Get PDF metadata",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pdfs/{{pdf_id}}",
              "host": ["{{base_url}}"],
              "path": ["pdfs", "{{pdf_id}}"]
            },
            "description": "Ownership + processing status, stage, progress, and a signed download URL for the original file."
          }
        }
      ]
    },
    {
      "name": "Extraction",
      "item": [
        {
          "name": "Get wall segments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pdfs/{{pdf_id}}/pages/{{page_number}}/segments",
              "host": ["{{base_url}}"],
              "path": ["pdfs", "{{pdf_id}}", "pages", "{{page_number}}", "segments"]
            },
            "description": "Wall-filtered line segments for one page, in PDF point space. 404s if page_number wasn't part of the selection at upload time."
          }
        },
        {
          "name": "Get snap points",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pdfs/{{pdf_id}}/pages/{{page_number}}/snap-points",
              "host": ["{{base_url}}"],
              "path": ["pdfs", "{{pdf_id}}", "pages", "{{page_number}}", "snap-points"]
            },
            "description": "Endpoint/midpoint/intersection snap points for one page, deduplicated. Same 404 rule as segments."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}
